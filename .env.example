# Server settings for ClockMe. Set these in Vercel → Project → Settings → Environment Variables, never in the repo.
# Use different values for Preview and Production where noted. Leaving one empty switches that feature off.

# Rota reading (Anthropic). Without it /api/read-rota answers 503 not_setup.
ANTHROPIC_API_KEY=
CLOCKME_MODEL=claude-sonnet-5-5

# Rate limits (Upstash Redis, added through Vercel Storage, which sets KV_REST_API_URL/TOKEN itself).
KV_REST_API_URL=
KV_REST_API_TOKEN=
ROTA_PER_HOUR=15
ROTA_PER_DAY=40
ROTA_DAILY_CAP=1000

# Stripe. Preview: sk_test_ and the test-mode webhook secret. Production: sk_live_ and the live webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=
PRO_TRIAL_DAYS=7

# Signs the Pro pass kept on each device. 32+ random bytes; a different value for Preview and Production.
CLOCKME_SIGNING_SECRET=

# Cloudflare Turnstile (the page also needs turnstile.siteKey in config/public.json).
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
